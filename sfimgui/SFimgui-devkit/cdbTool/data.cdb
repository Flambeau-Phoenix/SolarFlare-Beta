						"x": 12,
						"y": 0,
						"width": 2,
						"height": 2
					},
					"script": "function onReceiveDamage(dmg) {\n\tif (dmg.isWeaponSkill && dmg.isMagic) {\n\t\tplayStep(Steps.AOE);\n\t\twait(0, () -> {\n\t\t\tstop();\n\t\t});\n\t}\n}\n\nfunction onHit(hit) {\n\tif (rank >= 3) {\n\t\tif (checkProba(vars.chance)) {\n\t\t\thit.target.addStatus(Skill.Stun, 1, skill, sourceSkill.owner, vars.dur1);\n\t\t}\n\t}\n}",
					"duration": 12,
					"status": 2
				},
				{
					"id": "Halos_Demon_Skill1",

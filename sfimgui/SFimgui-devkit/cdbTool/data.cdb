					"cooldown": 3,
					"duration": 2.67,
					"script": "var targets = [];\nfunction onStepEnd(s) {\n\tif (isServer && s.kind == Steps.Cast && !s.cancelled) {\n\t\ttargets.push(toUnit(aimTarget));\n\t\tvar otherTargets = findTargets(Closest);\n\t\tfor (t in otherTargets) {\n\t\t\tif (targets.length >= vars.var1)\n\t\t\t\tbreak;\n\t\t\tif (!targets.contains(t))\n\t\t\t\ttargets.push(t);\n\t\t}\n\t\tnextTarget();\n\t}\n}\n\nfunction nextTarget() {\n\tif (targets.length > 0) {\n\t\tvar t = targets.shift();\n\t\tplayStep(Steps.Zap, t);\n\t}\n}\n\nfunction onHit(hit) {\n\tif (hit.stepId == Steps.Zap)\n\t\tnextTarget();\n}"
				},

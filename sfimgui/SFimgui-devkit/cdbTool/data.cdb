						"size": 48,
						"x": 14,
						"y": 0,
						"width": 2,
						"height": 2
					},
					"script": "function shouldHighlightSkill(){\n\treturn true;\n}\nfunction doDash(client) {\n\tvar marks = getInflictedStatuses(Skill.Fists_LightMonk_Skill1_Status);\n\tvar closestTarget = null;\n\tvar bestDistance = 0.;\n\tfor (m in marks) {\n\t\tvar distance = m.owner.distanceBetween(owner);\n\t\tif (closestTarget == null || bestDistance > distance) {\n\t\t\tclosestTarget = m.owner;\n\t\t\tbestDistance = distance;\n\t\t}\n\t}\n\n\tif (closestTarget == null)\n\t\treturn;\n\tskill.getCtx().aimTarget = closestTarget;\n\tif (client) {\n\t\tlocalPlayStep(Steps.Cast, closestTarget);\n\t} else {\n\t\tplayStep(Steps.Cast, closestTarget);\n\t\tconsumeStatus(closestTarget, Skill.Fists_LightMonk_Skill1_Status);\n\t}\n}\n\nfunction onStep(step) {\n\tif (step.kind == Steps.Start) {\n\t\tdoDash(false);\n\t}\n}\n\nfunction onClientStep(step) {\n\tif (step.kind == Steps.Start) {\n\t\tdoDash(true);\n\t}\n}",
					"status": 2,
					"duration": 0.5,
					"type": 8
				},

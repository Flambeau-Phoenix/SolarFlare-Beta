					"type": 0,
					"duration": 1,
					"script": "function onStep(s) {\n\tif (s.kind == Steps.Capture) {\n\n\t}\n}\n\nfunction onHit(hit) {\n\tif (hit.step.kind == Steps.Capture) {\n\t\tif (isCritter(hit.targetUnit)) {\n\t\t\tvar pos = hit.targetUnit.position;\n\t\t\tif (ownerHero?.tryCaptureCritter(hit.targetUnit)) {\n\t\t\t\tplayStep(Steps.Captured, hit.targetUnit, pos);\n\t\t\t} else {\n\t\t\t\tplayStep(Steps.Missed, hit.targetUnit, pos);\n\t\t\t}\n\t\t}\n\t}\n}"

						"damage": 0.5
					},
					"type": 11,
					"script": "function onHit(hit) {\n\tif (hit.stepId == Steps.BigBubble) {\n\t\tplayStep(Steps.MediumBubble, null, hit.projectile.position);\n\t}\n\tif (hit.stepId == Steps.MediumBubble) {\n\t\tplayStep(Steps.SmallBubble, null, hit.projectile.position);\n\t}\n}\n\nfunction onProjectileBouncedOnTerrain(proj, dir) {\n\treturn reflectToOriginOrEnemy(proj, dir, 40, 0.5);\n}\n\nfunction onDamageEval(hit) {\n\tif (hasStatus(hit.target, Skill.R1CrabBoss_Heroic_Bubble_Status)) {\n\t\thit.dmgMult += vars.damage;\n\t}\n}",

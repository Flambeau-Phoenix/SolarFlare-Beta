			"lines": [
				{
					"id": "PhysicalBlock",
					"nature": 2,
					"texts": {
						"name": "Parry",
						"desc": "Blocks incoming [Attack]s, reducing their damage by ::val1%::.\nPerfect blocking reduces their damage by an additional ::var2%:: and increases the damage of your next [Attack] by ::ref_damage%::.",
						"refs": {
							"ref": "PhysicalBlock_Status_WellTimed"
						}
					},
					"steps": [
						{
							"on": 0,
							"visuals": {
								"playAnims": [
									{
										"anim": {
											"ref": "Block",
											"loop": true,
											"blend": 0.15
										}
									}
								]
							},
							"props": {},
							"type": 11,
							"delay": 0.66,
							"id": "BlockAnim"
						},
						{
							"on": 13,
							"visuals": {
								"playAnims": [
									{
										"anim": {
											"ref": "BlockHit",
											"blend": 0,
											"restore": "BlockAnim"
										}
									}
								]
							},
							"props": {},
							"type": 11,
							"range": 0.2,
							"id": "OnHit",
							"duration": 0.2
						},
						{
							"on": 13,
							"visuals": {
								"playAnims": [
									{
										"anim": {
											"ref": "BlockHit",
											"blend": 0,
											"restore": "BlockAnim"
										}
									}
								],
								"fxs": [
									{
										"set": "Parry_Perfect",
										"space": 0,
										"props": {}
									}
								]
							},
							"props": {},
							"id": "OnWellTimed",
							"type": 11,
							"duration": 0.2,
							"range": 0.2
						}
					],
					"flags": 1248,
					"props": {
						"aimStyle": 1,
						"interruptStyle": 2
					},
					"vars": {
						"var2": 0.15
					},
					"gfx": {
						"file": "UI/icons/atlas_weapon_Sword1H_96PX.png",
						"size": 96,
						"x": 4,
						"y": 0
					},
					"type": 6,
					"cooldown": 0.5,
					"script": "function onBlockEval( hit ) {\n\tif( hit.hasBeat(GameBeat.BlockWellTimed) ) {\n\t\taddStatus(owner, Skill.PhysicalBlock_Status_WellTimed);\n\t\thit.block += vars.var2;\n\t}\n}",
					"mastery": [],
					"anim": {
						"ref": "BlockStart",
						"blend": 0.07
					},
					"affixes": [
						{
							"target": {
								"attribute": "BlockMitigation"
							},
							"target2": {},
							"ref": "TAttribute_Flat",
							"conds": {},
							"mod": {},
							"val": 50
						}
					]
				},
				{
					"id": "PhysicalBlock_Status_WellTimed",
					"nature": 4,
					"texts": {
						"desc": "Damage of your next [ComboAttack] increased by ::damage%::.",
						"name": "[PhysicalBlock]"
					},
					"anim": {},
					"steps": [],
					"flags": 0,
					"mastery": [],
					"props": {},
					"vars": {
						"damage": 0.3
					},
					"status": 2,
					"gfx": {
						"file": "UI/icons/atlas_weapon_Sword1H_96PX.png",
						"size": 96,
						"x": 4,
						"y": 0
					},
					"duration": 10,
					"script": "function onSkillProc(ctx) {\n\tif(ctx.skill.isFinalAttack()) {\n\t\tctx.dmgMult += vars.damage;\n\t\tstop();\n\t}\n}"
				},

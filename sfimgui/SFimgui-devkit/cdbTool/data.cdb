				{
					"id": "GM_MassGrab_Passive",
					"nature": 5,
					"texts": {
						"name": "Mad Buzz",
						"desc": "Dealing and taking damage has a ::chance:: chance to generate a stack of ::ref_name::, stacking up to ::ref_stacks:: times.\nAt ::ref_stacks:: stacks, summons an angry bee that starts attacking enemies for ::ref_dur1::, dealing ::ref2_dmg:: every ::ref_time::.",
						"refs": {
							"ref": "GM_MassGrab_Passive_Status",
							"ref2": "SummonBee_HoneyBolt",
							"ref3": "GM_MassGrab_Skill2"
						},
						"rankDescs": [
							{
								"desc": "Bees that walk through ::ref3_name::'s area enrage, increasing damage they deal by ::damage%::.",
								"flags": 0
							},
							{
								"desc": "Summoning a bee extends the duration of all summoned bees by ::ref_time::.",
								"flags": 0
							}
						]
					},
					"anim": {},
					"steps": [],
					"flags": 0,
					"mastery": [],
					"props": {},
					"vars": {
						"chance": 0.2,
						"damage": 0.5
					},
					"status": 2,
					"type": 24,
					"gfx": {
						"file": "UI/icons/atlas_weapon_Great_Mace_96PX.png",
						"size": 48,
						"x": 8,
						"y": 0,
						"width": 2,
						"height": 2
					},
					"script": "function onInflictDamage(dmg) {\n\ttryAddStatus();\n}\n\nfunction onReceiveDamage(dmg) {\n\ttryAddStatus();\n}\n\nfunction tryAddStatus() {\n\tif (checkProba(vars.chance)) {\n\t\taddStatus(owner, Skill.GM_MassGrab_Passive_Status);\n\t}\n}\n\nfunction onInflictDamageEval(dmg) {\n\tif (dmg.sourceUnit?.kind == Unit.Summon_Bee) {\n\t\tif (dmg.source.hasStatus(Skill.GM_MassGrab_Skill2_Status)) {\n\t\t\tdmg.dmgMult += vars.damage;\n\t\t}\n\t}\n}"
				},
				{
					"id": "GM_MassGrab_Passive_Status",
					"nature": 4,
					"texts": {
						"name": "Buzzing",
						"desc": "At ::stacks:: stacks, summons an angry bee that starts attacking enemies for ::dur1::, dealing ::ref_dmg:: every ::time::.",
						"refs": {
							"ref": "SummonBee_HoneyBolt"

					"vars": {},
					"status": 4,
					"script": "function onUpdate(dt) {\n\tif (ownerHero.isUnsafe())\n\t\townerHero.teleportSafeLocation();\n\tif (ownerHero.canResurrect())\n\t\tdeathStatus(Skill.Dead_Resurrect);\n\telse if (!ownerHero.isInFallDeath)\n\t\tdeathStatus(Skill.Dead_Hidden);\n}\n\nfunction deathStatus(kind) {\n\tif (!hasStatus(owner, kind)) {\n\t\tclearStatuses();\n\t\taddStatus(owner, kind);\n\t}\n}\n\nfunction clearStatuses() {\n\tremoveStatuses(owner, s -> s.instigatorSkill == skill);\n}\n\nfunction onStop(ctx) {\n\tclearStatuses();\n}"
				},

					"script": "function onStart(ctx) {\n\tfor (i in 0...Math.round(vars.var1)) {\n\t\tplayStep(Steps.Telegraph);\n\t}\n}\n\nfunction onAreaElapsed(area,units) {\n\tif (area.stepKind == Steps.Telegraph) {\n\t\tplayStep(Steps.Bubble, null, area.position);\n\t}\n}\n\nfunction onCreateArea(area) {\n\tif (area.stepKind == Steps.Bubble) {\n\t\troam(area, vars.speed, vars.time, ownerFoe.getOrigin(), vars.range, () -> area.removed);\n\t}\n}\n\nfunction onHit(hit) {\n\tif (hit.area != null && hit.area.stepKind == Steps.Bubble) {\n\t\thit.area.remove();\n\t}\n}"

					"nature": 5,
					"texts": {
						"name": "Chain Heal"
					},
					"anim": {},
					"steps": [
						{
							"on": 13,
							"props": {},
							"id": "Heal",
							"type": 6,
							"visuals": {
								"linkFx": {
									"set": "Water_Zap",
									"target": 2,
									"startAttach": "B_Chest",
									"targetAttach": "B_Chest"
								},
								"hitFx": "NoFX"
							},
							"effects": [
								{
									"effect": 1,
									"scaling": [
										{
											"ratio": 0.06,
											"atb": "Intellect"
										},
										{
											"ratio": 0.06,
											"atb": "Faith"
										}
									],
									"flags": 0
								}
							]
						}
					],
					"flags": 0,
					"mastery": [],
					"props": {},
					"vars": {
						"var1": 3,
						"heal": 0.3,
						"chance": 1,
						"charges": 3,
						"range": 40
					},
					"type": 27,
					"affixes": [
						{
							"target": {
								"attribute": "Fervor"
							},
							"target2": {},
							"ref": "TAttribute_MRatio",
							"conds": {
								"minRank": 2
							},
							"mod": {},
							"val": 1.025
						}
					],
					"script": "var nbCasts = 0;\n\nfunction onInflictHeal(hit) {\n\tif (hit.skillId != skill.kind && checkProba(vars.chance)) {\n\t\tvar heroes: Array<ent.Hero> = [];\n\t\tfor (p in owner.layer.players) {\n\t\t\tif (p.hero != null && p.hero != hit.target) {\n\t\t\t\tvar distance = p.hero.distanceSq(hit.target);\n\t\t\t\tif (distance <= vars.range * vars.range) {\n\t\t\t\t\tvar index = 0;\n\t\t\t\t\tfor (h in heroes) {\n\t\t\t\t\t\tif (h.healthRatio != p.hero.healthRatio && h.healthRatio >= 1 && p.hero.healthRatio < 1)\n\t\t\t\t\t\t\tbreak;\n\t\t\t\t\t\tif (h.distanceSq(hit.target) > distance)\n\t\t\t\t\t\t\tbreak;\n\t\t\t\t\t\tindex++;\n\t\t\t\t\t}\n\t\t\t\t\theroes.insert(index, p.hero);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tvar targets = heroes.slice(0, Math.round(vars.var1));\n\t\tfor (t in targets)\n\t\t\tplayStep(Steps.Heal, t);\n\t\tnbCasts = (nbCasts + 1) % vars.charges;\n\t}\n}\n\nfunction onInflictHealEval(hit) {\n\tif ( hit.skillId == skill.kind && nbCasts+1 == vars.charges  && rank >= 3 ) {\n\t\thit.critChance = 1;\n\t\thit.dmgMult += vars.heal;\n\t}\n}"
				},

						"var1": 30,
						"var2": 80
					},
					"type": 11,
					"duration": 0.2,
					"script": "function onReceiveHit(hit) {\n    if(!isServer || !running || elapsedTime < 0.1) // Grace period with no bumping\n        return;\n    if(hit.isDoT || hit.isStatus)\n        return;\n    var force = vars.var1;\n    if(!hit.isBaseAttack || hit.isFinalCombo)\n        force = vars.var2;\n    applyKnock(owner, hit.source.position, force, force * 0.3);\n}\n\nfunction onInflictDamageEval(hit) {\n\tif (hit.targetUnit != null && hit.targetUnit.kind == Unit.Golcano && !haveShield(hit.target)) {\n\t\thit.amount = 0;\n\t\thit.dmgMult = 0;\n\t\thit.dmgAdd = 0;\n\t}\n}",
					"status": 2
				},

					"script": "function onStart(ctx) {\n\tvar heroes = getEnemiesInRange(owner, 100);\n\tfor (i in 0...Math.round(vars.var1)) {\n\t\tvar h = heroes[i];\n\t\tplayStep(Steps.Mortar, h);\n\t}\n}"

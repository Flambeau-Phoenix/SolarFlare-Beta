							"effects": [
								{
									"effect": 0,
									"scaling": [
										{
											"ratio": 0.2,
											"atb": "FoePower"
										}
									],
									"sideEffects": {
										"knockBack": {
											"type": 0,
											"knockUpForce": 5,
											"pushForce": -3
										}
									},
									"affinity": "Honey",
									"flags": 0

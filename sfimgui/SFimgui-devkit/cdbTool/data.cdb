				{
					"id": "Mace_Benediction",
					"texts": {
						"flavorDesc": "Amon, ram-headed god of creation, appeared to Lady Skover in a vision. No one really believed her story at the time, but it did make the Rams appear more legitimate.",
						"name": "Amon Ram, the Creator"

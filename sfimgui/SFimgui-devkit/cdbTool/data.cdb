					"script": "function onInflictDamage(dmg) {\n\t// if (isServer && rank >= 2 && dmg.isFinalCombo) {\n\t// \tplayStep(Steps.R2_Damage, dmg.target);\n\t// }\n}\n\nfunction onSkillProc(ctx) {\n\tif(rank >= 3 && ctx.skill.isFinalAttack() && !status.isInfinite()) {\n\t\tstartSkill(Skill.Scepter_Flamie_Skill1_Area);\n\t}\n}\n\n\nfunction onRegUpdate(dt) {\n\tgetStepById(Steps.HealTick).tickInterval = (rank >= 2 && owner.healthRatio < vars.health) ? vars.time2 : vars.time;\n}\n\nfunction onReceiveDamageEval(hit) {\n\tif (rank >= 3 && hit.isMagic) {\n\t\thit.dmgMult -= vars.damage;\n\t}\n}"

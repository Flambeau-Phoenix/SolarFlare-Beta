					"status": 0,
					"type": 11,
					"cooldown": 12,
					"duration": 4.4,
					"script": "var ORB_BOUNCE_MAX_DISTANCE = 40;\n\nfunction onStep(s) {\n\tif( s.kind == Steps.SpawnOrbs ) {\n\t\tfor( _ in 0...getNbOrbsToSpawn() ) {\n\t\t\tplayStep(Steps.Orbs, owner);\n\t\t}\n\t}\n}\n\nfunction onSkillObjectEvent( obj, ev, target ) {\n\tif( ev == SkillObjectEvent.Spawn || ev == SkillObjectEvent.Pickup ) {\n\t\tvar pt = getRandomGroundPos(owner, 30, 15);\n\t\tpt = p3DclampAtRangeFromPt(pt, ownerFoe.getOrigin(), ORB_BOUNCE_MAX_DISTANCE);\n\t\tobj.bounceTo(pt, vars.var2, (o) -> { });\n\t}\n\tif( ev == SkillObjectEvent.End ) {\n\t\tplayStep(Steps.Area, null, obj.position);\n\t}\n}\n\nfunction getNbOrbsToSpawn() {\n\tvar currentOrbs = skill.getSkillObjects().length;\n\tvar nb = ceil(owner.getContextPlayerCount() * vars.var1) - currentOrbs;\n\treturn nb;\n}\n\nfunction checkEnabled() {\n\tif( getNbOrbsToSpawn() == 0 ) return Invalid;\n\treturn Ok;\n}"
				},

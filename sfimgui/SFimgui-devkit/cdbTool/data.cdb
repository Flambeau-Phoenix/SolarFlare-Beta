						"width": 2,
						"height": 2
					},
					"type": 7,
					"script": "function onHit(hit) {\n\tif (hit.area != null && hit.isFirstHit) {\n\t\thit.area.remove();\n\t\taddStatus(owner, Skill.Bow_BigGame_Status);\n\t\tplayStep(Steps.Explode, null, hit.area.position);\n\t}\n\n\tif (hit.stepId == Steps.Explode) {\n\t\taddStatus(hit.target, Skill.Bow_BigGame_Skill2_Status);\n\t}\n}",
					"cooldown": 12
				},

				{
					"typeStr": "10:FollowPosOnly,GroundSnap,FollowScale,StepLink,MatchNextArea,MatchProgress,NoAttach,NoFollow,IgnoreDistanceVisibility,OnlyVisibleToSelf",
					"name": "flags",
					"documentation": "StepLink: Fxs will be stopped with the skill step\nTargetStretch: Fx will be played for each target and stretched from skill owner to their target\nMatchNextArea: Fx will try to match the next step in the skill's timeline which defines an area (can be the step on which the fx is played)\nNoAttach: If an attach is given it will only serve as information for spawning position\nRangeUpdate: Will refresh the fx range every frame\nNoFollow: The VFX is created at the skill position and is never moved.",
					"opt": true
				}
			]
		},

					"type": 24,
					"script": "function onUseSkill(ctx) {\n\tif (ctx.isSkill && canDoMagicDamage(ctx.skill)) {\n\t\tif (!isInCooldown()) {\n\t\t\tctx.magicDmgMult += vars.damage;\n\t\t\tconsumeCooldown();\n\t\t}\n\t}\n}\n\nfunction onRegUpdate(dt) {\n\tenforceStatus(owner, Skill.DS_Bladeleaf_Passive_Status, !isInCooldown());\n}\n\nfunction onInflictDamage(dmg) {\n\tif (rank >= 3) {\n\t\tif (dmg.critical && dmg.skill.kind != skill.kind && isInCooldown()) {\n\t\t\tplayStep(Steps.Damage, dmg.target);\n\t\t}\n\t}\n}",
					"cooldown": 30

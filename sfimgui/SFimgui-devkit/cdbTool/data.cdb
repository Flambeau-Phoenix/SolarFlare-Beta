						"y": 0,
						"width": 2,
						"height": 2
					},
					"type": 24,
					"script": "function onInflictDamage(dmg) {\n\n\tvar spinSkill = owner.getSkill(Skill.Crescent_FlowerSpiral_Skill_1);\n\tif (dmg.isBaseAttack || (dmg.skill.inf.id == Skill.Crescent_FlowerSpiral_Skill_1 && spinSkill.rank >= 3)) {\n\t\tif (rank >= 3 && dmg.critical)\n\t\t\treduceCooldown(Skill.Crescent_FlowerSpiral_Skill_1, vars.time);\n\n\t\tplayStep(Steps.Damage, dmg.target);\n\t\taddStatusDuration(dmg.target, Skill.Crescent_FlowerSpiral_Passive_Slow, vars.time2);\n\t}\n}\n\nfunction onInflictDamageEval(hit) {\n\tif (isServer) {\n\t\tif (hit.skill.inf.id == Skill.Crescent_FlowerSpiral_Passive) {\n\t\t\tif (rank >= 2) {\n\t\t\t\tvar tunit = toUnit(hit.target);\n\t\t\t\tif (tunit != null && tunit.healthRatio <= vars.threshold) {\n\t\t\t\t\thit.dmgMult *= (1 + vars.var1);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n}"
				},

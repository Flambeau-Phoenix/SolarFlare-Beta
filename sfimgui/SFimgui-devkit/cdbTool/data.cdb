				{
					"id": "Spear_Eruption_Passive",
					"nature": 5,
					"texts": {
						"name": "Heart of the Furnace",
						"desc": "Your [Skill]s and [Attack]s increase your [Armor] by ::ref_val1%::, stacking up to ::ref_stacks:: times.",
						"rankDescs": [
							{
								"desc": "Stacks up to ::ref_stacks:: times.",
								"flags": 0
							},
							{
								"desc": "At ::ref_stacks:: stacks, critical strikes grant you a Shield equal to ::ref_var1%:: of the damage dealt for ::ref_dur1::.",
								"flags": 0
							}
						],
						"refs": {
							"ref": "Spear_Eruption_Passive_Status"
						}
					},
					"anim": {},
					"steps": [
						{
							"on": 0,
							"props": {},
							"type": 11,
							"duration": -1,
							"visuals": {
								"fxs": [
									{
										"set": "Lava_Aura_Spear",
										"props": {
											"offset": {
												"x": 0,
												"y": 0,
												"z": 1.2,
												"height": 0
											}
										},
										"attachName": "Weapon",
										"space": 0,
										"flags": 8
									}
								]
							}
						}
					],
					"flags": 0,
					"mastery": [],
					"props": {},
					"vars": {
						"var1": 0.3,
						"health": 0.25
					},
					"status": 2,
					"gfx": {
						"file": "UI/icons/atlas_weapon_Spear_96PX.png",
						"size": 48,
						"x": 14,
						"y": 0,
						"width": 2,
						"height": 2
					},
					"type": 24,
					"script": "var BUFF =  Skill.Spear_Eruption_Passive_Status;\nvar SHIELD = Skill.Spear_Eruption_Passive_Shield;\n\n\nfunction onInflictDamage(dmg) {\n\tif (dmg.isFirstHit && (dmg.isWeaponSkill || dmg.isFinalCombo || isSkillValid(dmg.skill) || isSkillValid(dmg.status?.getSourceSkill()))) {\n\t\taddStatus(owner, BUFF);\n\t}\n\tif (dmg.critical && rank >= 3 && hasStatusMaxStacked(owner, BUFF)) {\n\t\tvar amount = dmg.amount * vars.var1;\n\t\taddShield(owner, SHIELD, amount);\n\t}\n}\n\nfunction isSkillValid(skill) {\n\tif (skill == null) { return false; }\n\tif (skill.isBasicAttack() || skill.isFinalAttack() || skill.isWeaponSkill()) {\n\t\treturn true;\n\t}\n\treturn false;\n}"
				},

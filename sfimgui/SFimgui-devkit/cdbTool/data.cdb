					"script": "function onStacksChange() {\n\tif( stacks >= maxStacks ) {\n\t\tremoveStatus(owner, Skill.Shield_OrbitWater_P_Status);\n\t\taddStatus(owner, Skill.Shield_OrbitWater_P_StatusBlockBuffed);\n\t}\n\n}"

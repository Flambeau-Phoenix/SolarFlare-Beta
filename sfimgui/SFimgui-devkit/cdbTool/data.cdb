					"script": "/*function onGameBeat(beat, dmg) {\n\tif( beat == GameBeat.AttackBlock) {\n\t\treduceCooldown(Skill.Warrior_IgnorePain, vars.var1);\n\t}\n}*/\n\nfunction onStart(ctx) {\n\tif (hasMastery(Mastery.Warrior_IgnorePain_M2)) {\n\t\tsetDynVal(1, owner.maxHealth * vars.var2);\n\t\tplayStep(Steps.SelfHeal, owner);\n\t}\n\tif (hasMastery(Mastery.Warrior_IgnorePain_M1)) {\n\t\tonPlayerAllies(a -> {\n\t\t\tif (a != owner) {\n\t\t\t\taddStatus(a, Skill.Warrior_IgnorePainStatus_Allies);\n\t\t\t}\n\t\t});\n\t}\n}\n\nfunction onGameBeat(b,hit) {\n\tif (hasMastery(Mastery.Warrior_IgnorePain_M3)) {\n\t\tif (b == GameBeat.AttackBlock) {\n\t\t\treduceCooldown(skill.kind, vars.time);\n\t\t}\n\t}\n}",

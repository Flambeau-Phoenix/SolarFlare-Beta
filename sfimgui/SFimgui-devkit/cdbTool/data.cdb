					"duration": 0.45,
					"script": "function onFirstHit(hit) {\n\tif (hasMastery(Mastery.Mage_StaticNova_M3) && hit.ctx.totalHits >= vars.var1 && ownerHero?.mage != null) {\n\t\townerHero.mage.forceTriggerAllConduits();\n\t}\n}",

					"script": "var timer = 0.;\nvar interval = 0.;\n\nfunction onStart(ctx) {\n\ttimer = vars.dur1;\n\tfor (i in 0...Math.round(vars.dur1 / vars.time)) {\n\t\twait(i * vars.time, () -> {\n\t\t\tplayStep(Steps.Rock);\n\t\t});\n\t}\n}"

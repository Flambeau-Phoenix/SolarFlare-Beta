						{
							"on": 0,
							"props": {},
							"id": "SummonVFX",
							"type": 11,
							"visuals": {
								"fxs": [
									{
										"set": "Chaos_Blink_Appear",
										"props": {},
										"scale": 2
									}
								]
							}
						}
					],
					"flags": 0,
					"mastery": [],
					"props": {},
					"vars": {
						"speed": 2
					},
					"status": 0,
					"type": 11,
					"duration": 60,
					"script": "var direction = null;\nvar lastPick = -1.;\nvar cloud = null;\nvar RANGE_TO_ORIGIN = 57; // lower than the radius of SuperEliteDemon_FireWall\n\nfunction onCreateArea(area) {\n\tcloud = area;\n}\n\nfunction onHit(hit) {\n\tif (hit.stepId == Steps.Cloud && hit.area != null && !hit.area.removed) {\n\t\tvar f = requestSummonFoe(Unit.DemonSuperElite_Fairy_Guardian, hit.area.position);\n\t\tplayStep(Steps.SummonVFX, null, hit.area.position);\n\t\tif (f != null) {\n\t\t\tf.aggroUnit(hit.targetUnit);\n\t\t}\n\t\thit.area.remove();\n\t}\n}\n\nfunction onUpdate(dt) {\n\tif( cloud == null ) return;\n\tvar origin = ownerFoe.getOrigin();\n\tif( lastPick < 0 || (p2DDist(origin, cloud.position) > RANGE_TO_ORIGIN && elapsedTime > lastPick + 5) ) {\n        lastPick = elapsedTime;\n\t\tvar pos = getGroundRandomPosInRangeFromPt(origin, 0, 15);\n\t\tdirection = p3DSub(pos, cloud.position);\n    }\n    if(direction != null) {\n        moveTowards(cloud, p3DAdd(cloud.position, direction), vars.speed, dt, true);\n    }\n}"
				},

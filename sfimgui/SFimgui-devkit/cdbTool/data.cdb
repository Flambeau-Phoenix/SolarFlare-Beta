									"scaling": [
										{
											"ratio": 1,
											"atb": "FoePower"
										}
									],
									"flags": 0,
									"affinity": "Fire",
									"status": "Ratsar_Heroic_Burn"
								}
							]
						},
						{
							"on": 7,
							"props": {},
							"delay": 1.47
						}
					],
					"aiProps": {
						"castMaxRange": 30,
						"pickPrio": 5,
						"minTimeInCombat": 6,
						"targetProfile": [
							0
						]
					},
					"flags": 0,
					"mastery": [],
					"props": {
						"needTarget": true
					},
					"vars": {
						"var1": 2,
						"range": 6,
						"var2": 8
					},
					"type": 11,
					"cooldown": 25,
					"duration": 2.8,
					"script": "function onUpdate(dt) {\n    var spinStep = getStepById(Steps.Spin);\n    if(spinStep.isRunning()) {\n        var area = getClosestAreaBySkill(owner, Skill.Ratsar_GreatSlamAreaFire, owner, 8);\n        if(isInRange(owner, area, vars.range)) {\n            playStep(Steps.FireBlast, null, area.position);\n\n\t\t\tif (isHeroicMode) {\n\t\t\t\twithArea(area, () -> {\n\t\t\t\t\tfor (i in 0...Math.round(vars.var2)) {\n\t\t\t\t\t\tplayStep(Steps.Mortar);\n\t\t\t\t\t}\n\t\t\t\t});\n\t\t\t}\n\n\t\t\tarea.baseSkill.stop();\n        }\n    }\n}",
					"status": 2,
					"notes": "Ratsar always launch spin twice in a row, this is done through its UnitScript"
				},

					"duration": 6,
					"script": "function onInflictDamage(hit) {\n\tif (hit.isFinalCombo) {\n\t\tplayStep(Steps.Trigger, hit.target);\n\t\tif (owner != status.instigator || !hasSkill(Skill.Priest_Talent_SolarDevotion)) {\n\t\t\towner.tryConsumeStatus(Skill.Priest_Talent_Sunlight_Status, status.instigator);\n\t\t}\n\t}\n}\n\nfunction onStep(s) {\n\tif (s.kind == Steps.Trigger) {\n\t\tif (hasSkill(Skill.Priest_Talent_SunHalo)) {\n\t\t\tplayStep(Steps.AreaDamage, ctx.aimTarget);\n\t\t}\n\t\tplayStep(Steps.Damage, ctx.aimTarget);\n\n\t}\n}\nfunction onDamageEval(dmg) {\n\tif (dmg.stepId == Steps.AreaDamage) {\n\t\tdmg.dmgMult -= vars.damage;\n\t}\n}",

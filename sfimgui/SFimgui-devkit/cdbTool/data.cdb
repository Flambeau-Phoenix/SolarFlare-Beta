					],
					"flags": 0,
					"mastery": [],
					"props": {
						"costs": [
							{
								"amount": 100,
								"atb": "SpecialEnergy"
							}
						]
					},
					"vars": {
						"var1": 5,
						"range": 45
					},
					"type": 11,
					"script": "function onStep(s) {\n\tif (s.kind == Steps.Trigger) {\n\t\tvar trueClone = Math.floor(random(0, vars.var1));\n\t\tfor (i in 0...Math.ceil(vars.var1)) {\n\t\t\tvar progress:Float = i / vars.var1;\n\t\t\tvar point = getCircleFacingPos(progress, vars.range, WORLD_UP);\n\t\t\tpoint = point.add(ownerFoe.getOrigin());\n\t\t\tif (i == trueClone) {\n\t\t\t\tplayStep(Steps.TrueClone, null, point);\n\t\t\t} else {\n\t\t\t\tplayStep(Steps.FalseClone, null, point);\n\t\t\t}\n\t\t}\n\n\t\twait(0, () -> {\n\t\t\taddStatusDuration(owner, Skill.FairieSuperElite_Clones_Stealth, 1000);\n\t\t\towner.teleportPosition(ownerFoe.getOrigin());\n\t\t});\n\t}\n}\n\nvar hadSummons = false;\nvar hadExplosion = false;\nfunction onUpdate(dt) {\n\tvar sums = getSummons(kind);\n\tvar trueCloneAlive = false;\n\n\tif (sums.length > 0) {\n\t\thadSummons = true;\n\t}\n\tif (hadSummons) {\n\t\tif (sums.length < vars.var1) {\n\t\t\tfor (f in sums) {\n\t\t\t\tif (f.kind == Unit.DemonSuperElite_Fairy_TrueClone) {\n\t\t\t\t\ttrueCloneAlive = true;\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tif (!trueCloneAlive) {\n\t\t\t\tkillSummons();\n\t\t\t\tstopSkill();\n\t\t\t}\n\t\t}\n\t}\n}\n\nfunction onStop(ctx) {\n\thadSummons = false;\n\thadExplosion = false;\n\n\tvar sk = owner?.getSkill(Skill.FaerieEliteDemon_NightRain);\n\tif( sk != null && sk.checkEnabled() == Ok ) {\n\t\towner.forceUseSkill(Skill.FaerieEliteDemon_NightRain);\n\t}\n}\n\nfunction stopSkill() {\n\tremoveStatus(owner, Skill.FairieSuperElite_Clones_Stealth);\n\tstop();\n}",
					"status": 0,
					"aiProps": {
						"pickPrio": 10
					}
				},

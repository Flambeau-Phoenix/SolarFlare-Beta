						"width": 2,
						"height": 2
					},
					"type": 4,
					"script": "function onFirstHit(h) {\n\taddStatus(owner, Skill.Mace_Benediction_Status);\n\n}\n\nfunction onInflictDamage(dmg) {\n\tif (dmg.isFirstHit && dmg.skillId == Skill.Mace_Benediction_Combo && rank >= 3) {\n\t\tif (dmg.critical) {\n\t\t\taddStatus(owner, Skill.Mace_Benediction_Skill1_Proc);\n\t\t\tresetCooldown(Skill.Mace_Benediction_Skill1);\n\t\t}\n\t}\n\tif (rank >= 2 && dmg.stepId == Steps.Hit) {\n\t\tplayStep(Steps.Area, dmg.target);\n\t}\n}",
					"duration": 0.75
				},

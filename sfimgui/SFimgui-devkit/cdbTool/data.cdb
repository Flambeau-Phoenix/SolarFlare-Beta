						},
						{
							"on": 13,
							"props": {},
							"id": "PhysicalDamage",
							"type": 6,
							"effects": [
								{
									"effect": 0,
									"scaling": [
										{
											"ratio": 0.7,
											"atb": "Strength"
										}
									],

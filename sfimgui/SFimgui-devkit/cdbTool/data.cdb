					"script": "function onInflictDamage(dmg) {\n\tif(checkProba(vars.chance) && elapsedTime > 0 && (dmg.isBaseAttack || dmg.isWeaponSkill)) {\n\t\tvar status = addStatus(dmg.target, Skill.Daggers_DuplicatePoison_PassiveStatus);\n\t}\n}\nfunction onUpdate(dt) {\n\tif (owner == null || owner.instigatedStatuses == null) { return; }\n\tif (rank >= 3) {\n\t\tvar anyAtMaxStack = false;\n\t\tfor (s in owner.instigatedStatuses) {\n\t\t\tif (s.kind == Skill.Daggers_DuplicatePoison_PassiveStatus) {\n\t\t\t\tif (hasStatusMaxStacked(s.owner, Skill.Daggers_DuplicatePoison_PassiveStatus)) {\n\t\t\t\t\tanyAtMaxStack = true;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\tvar haveStatus = owner?.getStatusCount(Skill.Daggers_DuplicatePoison_Passive_Bonus) > 0;\n\t\tif (anyAtMaxStack) {\n\t\t\tif (!haveStatus) {\n\t\t\t\towner.addStatus(Skill.Daggers_DuplicatePoison_Passive_Bonus);\n\t\t\t}\n\t\t} else {\n\t\t\tif (haveStatus) {\n\t\t\t\tremoveStatus(owner, Skill.Daggers_DuplicatePoison_Passive_Bonus);\n\t\t\t}\n\t\t}\n\t}\n}\n\nfunction onInflictDamageEval(dmg) {\n\tif (dmg.skillId == Skill.Daggers_DuplicatePoison_PassiveStatus) {\n\t\tif (rank >= 2) {\n\t\t\tvar otherStatusCount = 0;\n\t\t\tfor (s in dmg.target.statuses) {\n\t\t\t\tif (s.getSourceSkill().owner == owner && s.kind != Skill.Daggers_DuplicatePoison_PassiveStatus) {\n\t\t\t\t\totherStatusCount++;\n\t\t\t\t}\n\t\t\t}\n\t\t\tdmg.dmgMult += otherStatusCount * vars.var1;\n\t\t}\n\t}\n}",
					"type": 24,
					"status": 2
				},

					"flags": 0,
					"mastery": [],
					"props": {
						"heroic": true
					},
					"vars": {},
					"type": 11,
					"script": "var gap = 0;\nvar totalProjPerRow = 25;\nvar margin = 8;\nvar projCount = 0;\n\nvar spawnPoints = [\n\t\"Wall_A\",\n\t\"Wall_B\",\n\t\"Wall_C\",\n\t\"Wall_D\"\n];\n\nfunction onStart(ctx) {\n\tgap = round(random(margin, totalProjPerRow - margin));\n\tprojCount = 0;\n}\n\nfunction onProjectileCreated(p) {\n\tif (isServer) {\n\t\tif (projCount == gap) {\n\t\t\tp.remove();\n\t\t}\n\n\t\tprojCount++;\n\t\tif (projCount >= totalProjPerRow) {\n\t\t\tprojCount = 0;\n\t\t}\n\t}\n}\n\nfunction onStep(step) {\n\tif (isServer) {\n\t\tif (step.kind == Steps.Trigger) {\n\t\t\tvar spawn = pickRandom(cast spawnPoints);\n\t\t\tvar p = getElement(owner, cast spawn);\n\t\t\tif (p != null) {\n\t\t\t\tshoot(p.position);\n\t\t\t} else {\n\t\t\t\tshoot(owner.position.sub(owner.getForward3D().scaled(25)));\n\t\t\t}\n\t\t}\n\t}\n}\n\nfunction shoot(pos) {\n\tplayStep(Steps.Bottom, null, pos);\n\tplayStep(Steps.Middle, null,pos);\n\tplayStep(Steps.Top, null, pos);\n}",
					"cooldown": 10
				},

						"y": 0,
						"width": 2,
						"height": 2
					},
					"script": "function onSkillProc(ctx) {\n\twait(0, () -> {\n\t\tvar s1Cd = skillValid(Skill.Halos_Demon_Skill2);\n\t\tvar s2Cd = skillValid(Skill.Halos_Demon_Skill1);\n\t\t//trace(\"Cooldown check \" + s1Cd + \" \" + s2Cd);\n\n\t\tif (s1Cd && s2Cd) {\n\t\t\tif (!hasStatus(owner, Skill.Halos_Demon_Passive_Status)) {\n\t\t\t\tplayStep(Steps.Shield, owner);\n\t\t\t}\n\t\t}\n\t});\n}\n\nfunction skillValid(skill) : Bool {\n\treturn (getSkill(skill) == null) || isSkillInCooldown(skill);\n}",
					"status": 2
				},

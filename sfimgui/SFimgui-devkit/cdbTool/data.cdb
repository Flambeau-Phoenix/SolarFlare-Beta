					"vars": {
						"var1": 15
					},
					"type": 11,
					"cooldown": 15,
					"script": "function onAreaStart(area) {\n\tif (isHeroicMode) {\n\t\twait(area.getRangeScaleDuration(), () -> {\n\t\t\tstartSkillAtPosition(Skill.Reblochonk_Heroic_CheeseExplosion, area.position);\n\t\t});\n\t}\n}\n\nvar explodedAreas:Array<{area1:st.skill.SkillArea, area2:st.skill.SkillArea}> = [];\nfunction onRegUpdate(dt) {\n\n\tif (!isHeroicMode) { return; }\n\n\tvar areas = skill.getAreas();\n\tfor (a1 in areas) {\n\t\tfor (a2 in areas) {\n\t\t\tif (a1 == a2) { continue; }\n\t\t\tvar p = getAreaOverlapPoint(a1, a2);\n\n\t\t\tvar existing = explodedAreas.filter(a -> (a.area1 == a1 && a.area2 == a2) || (a.area1 == a2 && a.area2 == a1)).length > 0;\n\t\t\tif (existing) { continue; }\n\t\t\tif (p != null) {\n\t\t\t\texplodedAreas.push({area1:a1, area2:a2});\n\t\t\t\tstartSkillAtPosition(Skill.Reblochonk_Heroic_CheeseExplosion, p);\n\t\t\t\tplayStep(Steps.Explosion, null, p);\n\t\t\t}\n\t\t}\n\t}\n}",
					"duration": 4.6,
					"status": 2,
					"gfx": {
						"file": "UI/Placeholder/Icons_Resources.png",
						"size": 48,
						"x": 36,
						"y": 38,
						"width": 2,
						"height": 2
					}

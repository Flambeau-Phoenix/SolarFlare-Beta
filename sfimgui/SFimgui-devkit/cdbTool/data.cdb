						"file": "UI/icons/atlas_class_Mage_96PX.png",
						"size": 96,
						"x": 4,
						"y": 0
					},
					"type": 10,
					"anim": {},
					"script": "function onPreSkillProc(ctx) {\n\tvar s = ctx.activeSkill;\n\tif(s.isWeaponSkill() || s.isFinalAttack() ) {\n\t\tvar hasChain = false;\n\t\tif (s.isWeaponSkill()) {\n\t\t\thasChain = owner.tryConsumeStatus(Skill.Mage_Talent_Chaincast_Status) > 0;\n\t\t}\n\t\tvar isFree = hasChain;\n\t\tif (!isFree)\n\t\t\tisFree = consumeStatus(owner, Skill.Mage_Foresight_Status) > 0;\n\t\tif (hasChain && ownerHero?.mage != null) {\n\t\t\townerHero?.mage.propagateMageChainCast(ctx);\n\t\t}\n\t\tif (!isFree) {\n\t\t\tvar cost = s.getSparkCost();\n\t\t\taddResource(Attribute.Spark, -cost);\n\t\t\tsetCustom(ctx, cost);\n\t\t}\n\t}\n}",
					"status": 2
				},
				{
					"id": "Mage_Conduit_Projectile",
					"nature": 5,
					"texts": {
						"name": "Conduit: Shard",
						"desc": "Fires ::var1:: shard at your target dealing ::dmg::.\n\nActivates when you consume [Spark] above the gauge threshold."
					},
					"steps": [
						{
							"on": 13,
							"props": {
								"projectile": {

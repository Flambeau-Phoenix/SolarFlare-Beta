					"status": 2,
					"script": "function onStacksChange() {\n\tif (hasStatusMaxStacked(owner, skill.kind)) {\n\t\tplayStep(Steps.Summon);\n\t\tnextFrame(() -> {status?.consume();});\n\t\tif (rank >= 3) {\n\t\t\textendSummonDuration(vars.time);\n\t\t}\n\t}\n}\n\n// function onInflictDamageEval(dmg) {\n// \tif (dmg.sourceUnit?.kind == Unit.Summon_Bee && dmg.source.hasStatus(Skill.GM_MassGrab_Skill2_Status)) {\n// \t\tdmg.dmgMult += vars.\n// \t}\n// }",

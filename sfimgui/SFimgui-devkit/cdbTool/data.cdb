					"gfx": {
						"file": "UI/icons/atlas_weapon_Staff_96PX.png",
						"size": 48,
						"x": 14,
						"y": 0,
						"width": 2,
						"height": 2
					},
					"type": 7,
					"duration": 1.5,
					"script": "var toCast = 0;\nvar chargeTimer = 0.;\n\nvar Charge = Skill.Staff_SummonDemon_Skill1_Status;\n\nfunction onStart(ctx) {\n\tcheckCharges();\n\t//trace(\"Shooting \" + toCast);\n}\n\nfunction onInflictDamage(dmg) {\n\tif (dmg.sourceUnit != owner) {\n\t\taddStatus(owner, Charge);\n\t}\n}\n\nfunction onRegUpdate(dt) {\n\tif (rank >= 2 && isInCombat()) {\n\t\tchargeTimer += dt;\n\t\tif (chargeTimer >= vars.time) {\n\t\t\tchargeTimer -= vars.time;\n\t\t\taddStatus(owner, Charge);\n\t\t}\n\t}\n}\n\n\nfunction checkStop() {\n\tif (isServer) {\n\t\tconsumeStatus(owner, Charge);\n\t\tif (rank >= 3) {\n\t\t\tif (checkProba(vars.chance)) {\n\t\t\t\tplayStep(Steps.Heal, owner);\n\t\t\t}\n\t\t}\n\t}\n\ttoCast--;\n\t//wait(0, () -> {\n\t\tif (toCast <= 0 && isServer) {\n\t\t\tstop(true);\n\t\t}\n\t//});\n}\n\n\nfunction onClientStart(ctx) {\n\tcheckCharges();\n}\n\nfunction onStepTick(s) {\n\tif (isServer && s.kind == Steps.Channel) {\n\t\tif (toCast > 0) {\n\t\t\t//trace(\"Fire \" + toCast);\n\t\t\tplayStep(Steps.Shoot);\n\t\t}\n\t\treturn;\n\t}\n\n\tif (s.kind == Steps.Shoot) {\n\t\tcheckStop();\n\t}\n}\n\nfunction checkEnabled() {\n\treturn getStatusCount(owner, Charge) > 0 ? Reason.Ok : Reason.Invalid;\n}\n\nfunction onClientStep(s) {\n\tif (s.kind == Steps.Shoot) {\n\t\tcheckStop();\n\t}\n}\n\nfunction checkCharges() {\n\ttoCast = getStatusCount(owner, Charge);\n}",
					"cooldown": 6,
					"status": 2
				},

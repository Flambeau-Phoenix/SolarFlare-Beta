					"texts": {
						"name": "Swarm Lord",
						"desc": "Your Weapon Skills surround you with an ::ref_name:: for ::ref_duration::.\n\n::ref_name:: deals ::ref_dmg:: to nearby enemies and heals you for ::var2%:: of that amount every ::ref_time::.",
						"rankDescs": [
							{
								"desc": "Increases your [Armor] by ::var1%::",

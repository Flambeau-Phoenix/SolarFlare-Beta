						"size": 96,
						"x": 3,
						"y": 2
					},
					"type": 24,
					"script": "function onSkillProc(ctx) {\n\tif (ctx.skill.isWeaponSkill()) {\n\t\taddStatus(owner, Skill.Sword_Swarm_Passive_Swarm);\n\t}\n}\n\nfunction onInflictDamage(dmg) {\n\tif( dmg.skillId == Skill.Sword_Swarm_Passive_Swarm) {\n\t\tif( checkProba(vars.chance) && rank >= 3 ) {\n\t\t\taddStatus(dmg.target, Skill.Sword_Swarm_Passive_Poison);\n\t\t}\n\t\tvar dmg = dmg.amount;\n\t\tvar amount = dmg * vars.var2;\n\t\tapplyHeal(owner, amount);\n \t}\n\n\n}",
					"status": 2
				},

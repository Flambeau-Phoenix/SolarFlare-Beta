					"script": "function onDamage(dmg) {\n\tif( hasStatus(owner, Skill.Demon_Spear_Skill_Status) ) {\n\t\tapplyHeal(owner, dmg.amount*vars.var1);\n\t\tplayStep(Steps.Heal);\n\t\tconsumeStatus(owner, Skill.Demon_Spear_Skill_Status);\n\t\taddStatus(dmg.target, Skill.Demon_Spear_Skill_Burn);\n\t}\n}\n\nfunction onDamageEval(dmg) {\n\tif( hasStatus(owner, Skill.Demon_Spear_Skill_Status) ) {\n\t\tdmg.dmgMult += vars.damage;\n\t}\n}"

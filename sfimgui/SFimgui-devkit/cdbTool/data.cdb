			"lines": [
				{
					"id": "Z1_Region",
					"type": 0,
					"texts": {
						"name": "Skover Island",
						"desc": "Southernmost region of Siagarta, Skover Island was once noted for its seafarers and pirates. It is now known as the land of the Crimson Rams, an order founded by Queen Skover herself."
					},
					"color": 16711680,
					"level": 1,
					"props": {
						"ambients": [
							{
								"ambient": "Music_Region_01"
							}
						],
						"renderAmb": "Default"
					}
				},
				{
					"id": "Z1_Meridion",
					"type": 1,
					"level": 5,

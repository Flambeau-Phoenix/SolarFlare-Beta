						"desc": "Your [ComboAttack] have a ::chance:: chance to deal ::dmg:: to your target and heal you for ::heal::."
					},
					"anim": {},
					"steps": [
						{
							"on": 13,
							"props": {},
							"id": "Attack",
							"type": 0,
							"effects": [
								{
									"effect": 0,
									"scaling": [],
									"flags": 0,
									"affinity": "Magic",
									"baseVal": 30
								}
							],
							"visuals": {
								"hitFx": "Hit_Chaos"
							}
						},
						{
							"on": 13,
							"props": {},
							"id": "Heal",
							"type": 12,
							"effects": [
								{
									"effect": 1,
									"scaling": [],
									"flags": 0,
									"baseVal": 10
								}
							]
						}
					],
					"flags": 0,
					"mastery": [],
					"props": {},
					"vars": {
						"var1": 0.5,
						"chance": 0.5
					},
					"type": 14,
					"script": "function onInflictHit(hit) {\n\tif( hit.isFinalCombo && checkProba(vars.chance)) {\n\t\tplayStep(Steps.Attack, hit.target);\n\t\tplayStep(Steps.Heal, owner);\n\t}\n}"
				},
				{
					"id": "Whetstone_Status",
					"nature": 4,
					"texts": {},
					"anim": {},
					"steps": [],
					"flags": 0,
					"mastery": [],
					"props": {
						"status": {
							"types": [
								{
									"type": "Buff"
								}
							],
							"stackingPolicy": 2,
							"persistant": true,
							"statusFlags": 1
						}
					},
					"vars": {},
					"script": "var weaponTypes = [\n\tItemType.Daggers, ItemType.Bow,\n\tItemType.Sword, ItemType.DualSwords, ItemType.GreatSword,\n\tItemType.Axe, ItemType.DualAxes, ItemType.GreatAxe,\n\tItemType.Thrown, ItemType.Spear, ItemType.Crescent,\n];\n\nfunction onStart(ctx) {\n\tremoveStatus(owner, Skill.Weighstone_Status);\n}\n\nfunction onRegUpdate(dt) {\n\tvar equipped = false;\n\tfor (t in weaponTypes) {\n\t\townerHero?.loadout.equipment.doOnAllItems((i, c) -> {\n\t\t\tif (i.isType(t))\n\t\t\t\tequipped = true;\n\t\t});\n\t}\n\tif (equipped)\n\t\ttryAddStatus();\n\telse\n\t\ttryRemoveStatus();\n}\n\nfunction onStop(ctx) {\n\ttryRemoveStatus();\n}\n\nfunction tryRemoveStatus() {\n\tremoveStatuses(owner, s -> s.kind == Skill.ItemStatus && s.getSourceItem() == status.getSourceItem());\n}\n\nfunction tryAddStatus() {\n\tvar alreadyAdded = false;\n\tif (owner.statuses != null) {\n\t\tfor (s in owner.statuses) {\n\t\t\tif (s.kind == Skill.ItemStatus && s.getSourceItem() == status.getSourceItem()) {\n\t\t\t\talreadyAdded = true;\n\t\t\t\tbreak;\n\t\t\t}\n\t\t}\n\t}\n\tif (!alreadyAdded)\n\t\taddStatus(owner, Skill.ItemStatus);\n}"
				},
				{
					"id": "Weighstone_Status",
					"nature": 4,
					"texts": {},
					"anim": {},
					"steps": [],
					"flags": 0,
					"mastery": [],
					"props": {
						"status": {
							"types": [
								{
									"type": "Buff"
								}
							],
							"stackingPolicy": 2,
							"persistant": true,
							"statusFlags": 1
						}
					},
					"vars": {},
					"script": "var weaponTypes = [ItemType.Shield, ItemType.Mace, ItemType.DualMaces, ItemType.GreatMace, ItemType.Fists];\n\nfunction onStart(ctx) {\n\tremoveStatus(owner, Skill.Whetstone_Status);\n}\n\nfunction onRegUpdate(dt) {\n\tvar equipped = false;\n\tfor (t in weaponTypes) {\n\t\townerHero?.loadout.equipment.doOnAllItems((i, c) -> {\n\t\t\tif (i.isType(t))\n\t\t\t\tequipped = true;\n\t\t});\n\t}\n\tif (equipped)\n\t\ttryAddStatus();\n\telse\n\t\ttryRemoveStatus();\n}\n\nfunction onStop(ctx) {\n\ttryRemoveStatus();\n}\n\nfunction tryRemoveStatus() {\n\tremoveStatuses(owner, s -> s.kind == Skill.ItemStatus && s.getSourceItem() == status.getSourceItem());\n}\n\nfunction tryAddStatus() {\n\tvar alreadyAdded = false;\n\tif (owner.statuses != null) {\n\t\tfor (s in owner.statuses) {\n\t\t\tif (s.kind == Skill.ItemStatus && s.getSourceItem() == status.getSourceItem()) {\n\t\t\t\talreadyAdded = true;\n\t\t\t\tbreak;\n\t\t\t}\n\t\t}\n\t}\n\tif (!alreadyAdded)\n\t\taddStatus(owner, Skill.ItemStatus);\n}"
				},

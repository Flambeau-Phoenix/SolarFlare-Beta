					"type": 7,
					"duration": 1.5,
					"gfx": {
						"file": "UI/icons/atlas_weapon_Staff_96PX.png",
						"size": 48,
						"x": 6,
						"y": 0,
						"width": 2,
						"height": 2
					},
					"cooldown": 12,
					"status": 2,
					"script": "var Proc = Skill.Staff_Craft_S1_Proc;\n\nfunction onInflictDamage(dmg) {\n\tif(dmg.isMagic && dmg.critical && rank >= 3) {\n\t\tif(checkProba(vars.chance)) {\n\t\t\taddStatus(owner, Proc);\n\t\t\tresetCooldown();\n\t\t}\n\t}\n\t// Must be done here instead of onHit to avoid applying the status before damage calculations\n\tif (dmg.skill == skill) {\n\t\taddStatus(dmg.target, Skill.Staff_Craft_S1_Status);\n\t}\n}\n\nfunction onInflictDamageEval(dmg) {\n\tif (rank >= 2 && dmg.target.getStatusTypeCount(StatusType.Slow) > 0) {\n\t\tdmg.dmgMult += vars.var1;\n\t}\n}\n\nfunction onProc(ctx) {\n\tremoveStatus(owner, Proc);\n}\n\nfunction haveProc() {\n\treturn owner.getStatusCount(Proc) > 0;\n}\n\nfunction shouldPlayInstantly() {\n\treturn haveProc();\n}\n\nfunction shouldHighlightSkill() {\n\treturn owner.getStatusCount(Proc) > 0;\n}"
				},

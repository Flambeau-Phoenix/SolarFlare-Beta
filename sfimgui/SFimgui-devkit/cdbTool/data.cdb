						"x": 0,
						"y": 0,
						"width": 2,
						"height": 2
					},
					"script": "function onSkillProc(ctx) {\n\tif (ctx.skill.isActiveSkill()) {\n\t\tvar chainReady = hasStatus(owner, Skill.Mage_Talent_Chaincast_Status);\n\t\tif (!chainReady) {\n\t\t\tvar chainCount = getStatusCount(owner, Skill.Mage_Talent_Chaincast_Accum_Status);\n\t\t\tchainCount++;\n\t\t\tif (chainCount < vars.var1) {\n\t\t\t\tsetStatus(owner, Skill.Mage_Talent_Chaincast_Accum_Status, chainCount);\n\t\t\t} else {\n\t\t\t\tremoveStatus(owner, Skill.Mage_Talent_Chaincast_Accum_Status);\n\t\t\t\tsetStatus(owner, Skill.Mage_Talent_Chaincast_Status);\n\t\t\t}\n\t\t}\n\t}\n}\nfunction onMageChainCast(ctx) {\n\townerHero?.mage?.forceTriggerAllConduits();\n\t// Need to wait next frame for charge to be consummed.\n\twait(0, () -> {\n\t\tctx.activeSkill?.resetCooldown();\n\t});\n}",
					"status": 2
				},

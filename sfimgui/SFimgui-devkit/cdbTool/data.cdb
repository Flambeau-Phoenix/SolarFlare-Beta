					"script": "function onStep(step) {\n\tif (step.inf.id == Steps.Start) {\n\t\tvar crab = toCrabgantua(owner);\n\t\tvar pos = crab.getShardDropPoint(vars.range, vars.var2, vars.minRange);\n\t\tvar travelTime = vars.time;\n\t\tcrab.dropShardFX(pos, travelTime);\n\t\tplayStep(Steps.Area, null, pos);\n\t}\n}\n\nfunction onAreaTick(area) {\n\tif(!owner.isInCombat || owner.isDead())\n\t\treturn;\n\towner.createSubElement(Element.R1CrabBoss_Shard, area.position);\n\tif (isHeroicMode) {\n\t\tstartSkill(Skill.R1CrabBoss_Heroic_Avalanche);\n\t\tvar crab = toCrabgantua(owner);\n\t\tcrab.spawnSpikeCrab();\n\t}\n}",
					"status": 2
				},

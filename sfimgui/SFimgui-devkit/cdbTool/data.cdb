					"vars": {
						"var1": 0.35
					},
					"script": "function onStart(app) {\n\tvar missing = owner.maxHealth - owner.health;\n\tstatus.setShield(missing * vars.var1);\n}\n\nfunction onUpdate(dt) {\n\tif(!status.instigatorSkill.isRunning())\n\t\tstop();\n}",
					"status": 2,
					"duration": 8
				},
